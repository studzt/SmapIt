<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SmapIt Manager</AssemblyName>
	
	  <Version>1.0.0</Version>
	
	  <ApplicationIcon>SmapIt.ico</ApplicationIcon>
	  
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="SmapIt.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="9.0.10" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Sentry" Version="5.16.2" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.10" />
    <PackageReference Include="WindowsShortcutFactory" Version="1.2.0" />
  </ItemGroup>

    <ItemGroup>
	    <EmbeddedResource Include="resources\**\*" />
    </ItemGroup>

  <ItemGroup>
	  <None Update="lang\*">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </None>
  </ItemGroup>
</Project>
